{
  // ШАБЛОН конфигурации. Скопируй в appsettings.json (он в .gitignore) и заполни реальными значениями,
  // ЛИБО задай через переменные окружения в проде (env-vars переопределяют appsettings).
  // Секреты сюда НЕ коммитим — только пустые плейсхолдеры.
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "ServerSettings": {
    "BaseUrl": "https://localhost:7132"
  },
  "ConnectionStrings": {
    "CloudflareStorageServiceURL": "",          // https://<account-id>.r2.cloudflarestorage.com
    "CloudflareStorageAccessKey": "",           // R2 Access Key ID
    "CloudflareStorageSecretAccessKey": "",     // R2 Secret Access Key
    "AppDb-production": "",                      // Host=...;Port=...;Database=...;Username=...;Password=...
    "AppDb": "",                                // строка подключения dev/test БД
    "GoogleClientId": "",                        // Google OAuth Client ID
    "GoogleClientSecret": ""                     // Google OAuth Client Secret
  },
  "Jwt": {
    "Key": "",                                   // случайный секрет >= 32 байт (НЕ человекочитаемая строка)
    "Issuer": "GmarketApi",
    "Audience": "GmarketFront"
  },
  "OxaPay": {
    "MerchantApiKey": "",
    "PayoutApiKey": "",
    "CallbackUrl": "",                           // https://<host>/api/payment/webhook
    "PayoutCallbackUrl": "",                     // https://<host>/api/payment/payout-webhook
    "ReturnUrl": "",                             // https://<frontend>/me/profile
    "Sandbox": true
  },
  "AllowedOrigins": [
    "http://localhost:4321",
    "http://localhost:5242",
    "https://localhost:7132"
  ],
  "Frontend": "http://localhost:4321",
  "CookieDomain": "",                            // прод: ".creohub.xyz" (общий cookie для api.creohub.xyz и creohub.xyz); dev: пусто

  "Telegram": {
    "BotToken": ""                               // токен Telegram-бота
  },

  "Smtp": {
    "Host": "",
    "Port": "587",
    "Username": "",
    "Password": "",
    "FromAddress": "",
    "FromName": "CreoHub"
  },

  "Pricing": {
    "MinOvershoot": 1.2,
    "MaxOvershoot": 2.0,
    "CapN": 30
  }
}
