@{
    Layout = null;
    string userName  = ViewBag.UserName  ?? "Пользователь";
    string userEmail = ViewBag.UserEmail ?? "";
}
<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <title>Подписка AutoSlot</title>
    <style>
        * { box-sizing: border-box; margin: 0; padding: 0; }
        body {
            font-family: Arial, sans-serif;
            display: flex;
            align-items: flex-start;
            justify-content: flex-start;
            height: 100vh;
            background-color: #1e1e1e;
            color: #fff;
            padding: 10px;
        }
        .mainContainer {
            min-width: 280px;
            max-width: 300px;
            background-color: #2b2b2b;
            border-radius: 12px;
            box-shadow: 0 0 15px rgba(240,248,255,0.2);
            padding: 20px;
            text-align: center;
        }
        h1 { font-size: 18px; margin-bottom: 6px; }
        .subtitle { font-size: 13px; color: #bbb; margin-bottom: 16px; }

        /* Чип аккаунта */
        .account-chip {
            display: flex;
            align-items: center;
            justify-content: space-between;
            background: #3a3a3a;
            border-radius: 8px;
            padding: 8px 10px;
            margin-bottom: 14px;
            gap: 8px;
        }
        .account-chip-info { text-align: left; overflow: hidden; }
        .account-chip-name {
            font-size: 13px;
            font-weight: bold;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
            max-width: 170px;
        }
        .account-chip-email {
            font-size: 11px;
            color: #aaa;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
            max-width: 170px;
        }
        .account-chip-logout {
            flex-shrink: 0;
            font-size: 11px;
            color: #ff9800;
            cursor: pointer;
            background: none;
            border: none;
            text-decoration: underline;
            white-space: nowrap;
        }
        .account-chip-logout:hover { color: #ffcc80; }

        /* Кнопка оформления */
        .btn-subscribe {
            display: block;
            width: 100%;
            padding: 11px;
            background: #ff9800;
            border: none;
            border-radius: 8px;
            color: #000;
            font-weight: bold;
            font-size: 14px;
            cursor: pointer;
            transition: background 0.2s;
            margin-bottom: 14px;
        }
        .btn-subscribe:hover { background: #ffa726; }

        .promo-section { margin-bottom: 14px; }
        .promo-row { display: flex; gap: 6px; margin-top: 6px; }
        .promo-row input {
            flex: 1; padding: 8px; background: #3b3b3b; border: none;
            border-radius: 5px; color: #fff; font-size: 13px; text-align: center;
            text-transform: uppercase;
        }
        .promo-row button {
            padding: 8px 12px; background: #ff9800; border: none; border-radius: 5px;
            color: #000; font-weight: bold; cursor: pointer; font-size: 13px;
        }
        .promo-row button:hover { background: #ffa726; }
        #promo-status { font-size: 12px; margin-top: 5px; min-height: 16px; }

        #waiting-hint { font-size: 11px; color: #888; text-align: center; margin-bottom: 14px; }

        .support-links { display: flex; justify-content: space-around; font-size: 13px; }
        .support-links div { cursor: pointer; color: #ff9800; }
        .support-links div:hover { color: #ffcc80; }
    </style>
</head>
<body>
<div class="mainContainer">
    <h1>AutoSlot</h1>
    <div class="subtitle">Для доступа к панели необходима подписка</div>

    <!-- Чип залогиненного аккаунта -->
    <div class="account-chip">
        <div class="account-chip-info">
            <div class="account-chip-name">@userName</div>
            @if (!string.IsNullOrEmpty(userEmail))
            {
                <div class="account-chip-email">@userEmail</div>
            }
        </div>
        <button class="account-chip-logout" onclick="window.location.href='/autoslot/auth/logout'">
            Разлогиниться
        </button>
    </div>

    <!-- Кнопка оформления подписки — редирект на сайт -->
    <button class="btn-subscribe" onclick="openURL('http://localhost:4321/services/autoslot/subscribe')">
        🛒 Оформить подписку
    </button>

    <div class="promo-section">
        <div class="subtitle">Есть промо-код?</div>
        <div class="promo-row">
            <input type="text" id="promo-input" placeholder="AUTOSLOT-XXXXXXXX">
            <button onclick="redeemCode()">→</button>
        </div>
        <div id="promo-status"></div>
    </div>

    <div id="waiting-hint">⏳ Ожидаем оплату на сайте...</div>

    <div class="support-links">
        <div onclick="openURL('https://creohub.xyz')">🌐 Creohub</div>
        <div onclick="openURL('https://t.me/DeFaustus')">💬 Support</div>
    </div>
</div>

<script src="/_content/Creohub.AutoSlot/js/helpers/evaluateWithResponse.js"></script>
<script src="/_content/Creohub.AutoSlot/js/helpers/fetchCode.js"></script>
<script src="/_content/Creohub.AutoSlot/js/shell.js"></script>
<script>
    // Поллинг: как только подписка активирована — перезагружаем панель
    (function startSubscriptionPoll() {
        async function check() {
            try {
                const res  = await fetch('/autoslot/subscription-ping');
                const data = await res.json();
                if (data.active) {
                    const hint = document.getElementById('waiting-hint');
                    if (hint) { hint.style.color = '#4c4'; hint.textContent = '✅ Подписка активирована! Загружаем...'; }
                    setTimeout(() => { window.location.href = '/autoslot/'; }, 800);
                    return;
                }
            } catch (_) {}
            setTimeout(check, 3000);
        }
        setTimeout(check, 3000);
    })();

    async function redeemCode() {
        const code = document.getElementById('promo-input').value.trim();
        const statusEl = document.getElementById('promo-status');
        if (!code) return;

        statusEl.style.color = '#bbb';
        statusEl.textContent = 'Проверяем...';

        try {
            const res = await fetch('/autoslot/redeem', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ code })
            });
            if (res.ok) {
                statusEl.style.color = '#4c4';
                statusEl.textContent = '✅ Код активирован! Загружаем панель...';
                setTimeout(() => { window.location.href = '/autoslot/'; }, 1200);
            } else {
                statusEl.style.color = '#f44';
                statusEl.textContent = 'Код недействителен или уже использован';
            }
        } catch {
            statusEl.style.color = '#f44';
            statusEl.textContent = 'Ошибка сети';
        }
    }
</script>
</body>
</html>
